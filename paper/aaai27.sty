%%
%% aaai27.sty --- AAAI style file (compatible with AAAI 2025/2026/2027 formatting)
%% Based on the official AAAI author kit. Replace with the official aaai27.sty
%% when the AAAI-27 author kit is released (expected July 2026).
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aaai27}[2025/01/01 AAAI 2027 Proceedings Style]

%% Page geometry: 8.5 x 11 inch, two-column, 9pt base font
\RequirePackage[
  paperwidth=8.5in, paperheight=11in,
  top=0.75in, bottom=1.00in,
  left=0.75in, right=0.75in,
  columnsep=0.25in,
  headheight=14pt
]{geometry}

\RequirePackage{times}
\RequirePackage{helvet}
\RequirePackage{courier}
\RequirePackage{microtype}
\RequirePackage{ifthen}
\RequirePackage{xcolor}
\RequirePackage{eso-pic}

%% Two-column layout
\AtBeginDocument{\twocolumn}

%% Abstract environment
\renewenvironment{abstract}{%
  \centerline{\textbf{Abstract}}%
  \vspace{0.5ex}%
  \small
}{%
  \par
}

%% Section heading formatting
\RequirePackage{titlesec}
\titleformat{\section}{\normalsize\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.5em}{}

%% No paragraph indentation; small inter-paragraph spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}

%% Caption styling
\RequirePackage[font=small,labelfont=bf]{caption}
%% No natbib -- aaai-named uses standard numeric citations

\endinput
