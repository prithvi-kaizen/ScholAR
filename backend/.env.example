# Local model server used for text generation, study goals, and vision requests.
OLLAMA_BASE_URL=http://localhost:11434

# Default model. Visual questions require a multimodal model.
OLLAMA_MODEL=qwen3.5:9b

# Optional generation settings. The defaults below match the application.
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=16000
OLLAMA_NUM_PREDICT=1650
OLLAMA_TIMEOUT=240

# Optional paired image/text retrieval encoder. The snapshot must be acquired
# separately; user-query handling is cache-only and never downloads it.
SCHOLAR_VISUAL_EMBEDDING_MODEL=openai/clip-vit-base-patch32
SCHOLAR_VISUAL_EMBEDDING_DEVICE=auto
SCHOLAR_VISUAL_EMBEDDING_BATCH_SIZE=8
# Conservative pre-calibration cosine floor. Tune only on a paper-disjoint
# development set; it is a routing guard, not a support probability.
SCHOLAR_VISUAL_MIN_SIMILARITY=0.20
# Conservative pre-calibration MaxSim floor for full-page patch retrieval.
SCHOLAR_VISUAL_PAGE_MIN_SIMILARITY=0.12

# Always-on full-page retriever. `auto` prefers the document-trained ColQwen2
# backend when its local snapshot exists and otherwise records a CLIP fallback.
# Accepted values: auto, colqwen2, clip, disabled.
SCHOLAR_VISUAL_PAGE_BACKEND=auto
SCHOLAR_DOCUMENT_VISUAL_MODEL=vidore/colqwen2-v1.0-hf
SCHOLAR_DOCUMENT_VISUAL_DEVICE=auto
# ColQwen2 MaxSim scores are not cosine probabilities. Leave this permissive
# until a paper-disjoint development set supplies a frozen routing threshold.
SCHOLAR_COLQWEN_MIN_SCORE=-1000000000

# Network boundary for runtime operations:
# - strict-local: prepared assets + loopback model endpoints only
# - acquisition-enabled: permits explicit arXiv/reference/PDF acquisition
SCHOLAR_NETWORK_MODE=strict-local

# Optional pre-provisioned Docling model directory. Without it, strict-local
# ingestion uses the labeled PyMuPDF fallback and performs no parser download.
DOCLING_ARTIFACTS_PATH=
