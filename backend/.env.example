# Local model server used for text generation, study goals, and vision requests.
OLLAMA_BASE_URL=http://localhost:11434

# Default model. Visual questions require a multimodal model.
OLLAMA_MODEL=qwen3.5:9b

# Optional generation settings. The defaults below match the application.
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=16000
OLLAMA_NUM_PREDICT=1650
OLLAMA_TIMEOUT=240
